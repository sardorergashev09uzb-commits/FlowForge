# ============================================================================
# FlowForge Enterprise v2.0 — Environment Configuration Example
# ============================================================================

# Backend Database (MySQL / MariaDB or automatic SQLite WAL fallback)
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=flowforge_db;charset=utf8mb4"
DB_USER="root"
DB_PASS=""

# Security & JWT Configuration
COOKIE_VALIDATION_KEY="change_this_to_a_long_random_secret_string"
JWT_SECRET="change_this_to_a_secure_256_bit_jwt_signing_key"
JWT_ACCESS_TTL="604800"

# Frontend API URL
VITE_API_BASE_URL="http://127.0.0.1:8080/api/v1"
